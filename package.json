{
  "name": "keira4",
  "description": "Keira4 is a modern editor for AzerothCore and TrinityCore servers, making it easier to create, edit, and manage World of Warcraft private servers.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint --cache",
    "fmt": "prettier --cache --write . --log-level silent",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "tauri": "tauri"
